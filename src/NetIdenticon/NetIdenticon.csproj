<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>NetIdenticon</PackageId>
    <Version>1.0.0</Version>
    <Authors>gitPhate</Authors>
    <Description>A .NET port of GitHub's identicon algorithm (dgraham/identicon), rendered with SkiaSharp.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>identicon;avatar;github;skiasharp;image</PackageTags>
    <RepositoryUrl>https://github.com/gitPhate/NetIdenticon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="NetIdenticon.Tests" />
    <InternalsVisibleTo Include="NetIdenticon.ReferenceTests" />
  </ItemGroup>

</Project>
